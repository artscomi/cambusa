// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String              @id @default(cuid())
  clerkUserId        String              @unique // Store Clerk user ID
  name               String
  email              String              @unique
  ownedGroups        Group[]             @relation("GroupOwner")
  memberships        GroupMembership[] // Relation to the groups the user is a member of
  foodPreferences    FoodPreference[] // Food preferences of the user
  alcoholPreferences AlcoholPreference[] // Alcohol preferences of the user
  waterPreferences   WaterPreference[] // Water preferences of the user
  apiCallCount       Int                 @default(0)
  hasPaidForIncrease Boolean             @default(false)
  lastApiCall        DateTime?
  mealList           String              @default("[]")
}

model Group {
  id                 String              @id @default(cuid())
  name               String
  ownerId            String
  owner              User                @relation("GroupOwner", fields: [ownerId], references: [clerkUserId])
  members            GroupMembership[]
  foodPreferences    FoodPreference[]
  alcoholPreferences AlcoholPreference[]
  waterPreferences   WaterPreference[]
  menuItemVotes      MenuItemVote[]
  breakfast          String              @default("0")
  lunch              String
  dinner             String
  people             String
  sameBreakfast      Boolean             @default(false)
  mealList           String? // JSON del menu generato per il gruppo
}

model FoodPreference {
  id         String @id @default(cuid())
  userId     String
  user       User   @relation(fields: [userId], references: [clerkUserId])
  groupId    String
  group      Group  @relation(fields: [groupId], references: [id])
  preference String
}

model AlcoholPreference {
  id         String @id @default(cuid())
  userId     String
  user       User   @relation(fields: [userId], references: [clerkUserId])
  groupId    String
  group      Group  @relation(fields: [groupId], references: [id])
  preference String
}

model WaterPreference {
  id         String @id @default(cuid())
  userId     String
  user       User   @relation(fields: [userId], references: [clerkUserId])
  groupId    String
  group      Group  @relation(fields: [groupId], references: [id])
  preference String
}

model GroupMembership {
  id      String @id @default(uuid())
  userId  String
  groupId String
  user    User   @relation(fields: [userId], references: [clerkUserId], onDelete: Cascade)
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId]) // Ensures a user can only join a group once
}

// Un voto per (gruppo, utente, pasto). Un utente può dare un solo voto per pasto.
model MenuItemVote {
  id         String @id @default(cuid())
  groupId    String
  group      Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId     String // Clerk user id
  mealTypeId String // es. "colazioni", "pranzi", "cene"
  mealId     String // id del pasto nel menu, es. "colazione1"
  value      Int // 1-5 stelle

  @@unique([groupId, userId, mealTypeId, mealId])
}

// Cambusa Express: lista della spesa condivisa, senza registrazione.
// Gli ospiti sono riconosciuti da un token casuale salvato in un cookie.
model ExpressList {
  id           String        @id @default(cuid())
  name         String
  people       Int?
  creatorToken String
  createdAt    DateTime      @default(now())
  items        ExpressItem[]
}

model ExpressItem {
  id          String        @id @default(cuid())
  listId      String
  list        ExpressList   @relation(fields: [listId], references: [id], onDelete: Cascade)
  text        String
  category    String
  addedByName String
  addedBy     String // token dell'ospite che l'ha aggiunto
  checked     Boolean       @default(false)
  createdAt   DateTime      @default(now())
  votes       ExpressVote[]

  @@index([listId])
}

// Un voto per (prodotto, ospite): +1 o -1.
model ExpressVote {
  id     String      @id @default(cuid())
  itemId String
  item   ExpressItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  voter  String
  value  Int

  @@unique([itemId, voter])
}
